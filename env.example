# ─────────────────────────────────────────
# FREELANCER BOT — Environment Variables
# cp .env.example .env → fill in the values
# NEVER commit .env to git
# ─────────────────────────────────────────

# ─── n8n ──────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong_password
N8N_ENCRYPTION_KEY=change_me_32_char_random_string
N8N_USER_MANAGEMENT_JWT_SECRET=change_me_32_char_random_string

# Optional: set if using a domain (SaaS phase)
# N8N_HOSTNAME=n8n.yourdomain.com

# ─── Caddy ────────────────────────────────
# Optional: for HTTPS (SaaS phase)
# WEBUI_HOSTNAME=chat.yourdomain.com
# LETSENCRYPT_EMAIL=you@yourdomain.com

# ─── Timezone ─────────────────────────────
GENERIC_TIMEZONE=Europe/Istanbul

# ─── Freelancer Profile ───────────────────
FREELANCER_NAME=Your Name
FREELANCER_SKILLS=Python, FastAPI, Docker, AI
FREELANCER_HOURLY_RATE=25
FREELANCER_MIN_BUDGET=100
FREELANCER_CURRENCY=USD

# ─── Phase 3 (SaaS) — leave empty for now ─
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# FLOWISE_USERNAME=
# FLOWISE_PASSWORD=
# MINIO_ROOT_PASSWORD=
# LANGFUSE_SALT=
# ENCRYPTION_KEY=
# NEXTAUTH_SECRET=
