# Freelancer Bot environment variables.
# Copy this file to .env and replace placeholders before running services.
# Never commit .env because it contains local secrets.

# --- n8n ---

# Username for n8n basic authentication.
N8N_BASIC_AUTH_USER=admin

# Password for n8n basic authentication.
N8N_BASIC_AUTH_PASSWORD=YOUR_PASSWORD_HERE

# Encryption key used by n8n to protect stored credentials.
N8N_ENCRYPTION_KEY=YOUR_SECRET_KEY_HERE

# JWT secret used by n8n user management.
N8N_USER_MANAGEMENT_JWT_SECRET=YOUR_SECRET_KEY_HERE

# Optional public hostname for n8n when running behind Caddy.
# N8N_HOSTNAME=n8n.yourdomain.com

# --- Caddy ---

# Optional public hostname for Open WebUI when running behind Caddy.
# WEBUI_HOSTNAME=chat.yourdomain.com

# Email address used by Caddy for Let's Encrypt certificates.
# LETSENCRYPT_EMAIL=you@yourdomain.com

# --- Local defaults ---

# Timezone used by local services and the FreelancerProfile config.
GENERIC_TIMEZONE=Europe/Istanbul

# --- FreelancerProfile ---

# Display name used by future prompt/profile logic.
FREELANCER_NAME=YOUR_NAME_HERE

# Professional title used by future prompt/profile logic.
FREELANCER_TITLE=Full Stack Developer

# Comma-separated skills used by future prompt/profile logic.
FREELANCER_SKILLS=Python, FastAPI, Docker, AI

# Hourly rate used by future prompt/profile logic.
FREELANCER_HOURLY_RATE=25

# Minimum project budget used by future prompt/profile logic.
FREELANCER_MIN_BUDGET=100

# Currency code used for rates and budgets.
FREELANCER_CURRENCY=USD

# Comma-separated languages used by future prompt/profile logic.
FREELANCER_LANGUAGES=English

# --- Phase 3 SaaS placeholders ---

# PostgreSQL username for a future SaaS database.
# POSTGRES_USER=YOUR_USERNAME_HERE

# PostgreSQL password for a future SaaS database.
# POSTGRES_PASSWORD=YOUR_PASSWORD_HERE

# PostgreSQL database name for a future SaaS database.
# POSTGRES_DB=freelancer_bot

# Encryption key for optional future SaaS services.
# ENCRYPTION_KEY=YOUR_SECRET_KEY_HERE

# NextAuth secret for optional future SaaS authentication.
# NEXTAUTH_SECRET=YOUR_SECRET_KEY_HERE
